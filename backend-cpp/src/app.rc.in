#include <winver.h>

101 ICON "@MANGAFLOW_ICON_RC_PATH@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 2,0,0,0
 PRODUCTVERSION 2,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "MangaFlow AI"
            VALUE "FileDescription", "MangaFlow AI - Native C++17 Comic Translator"
            VALUE "FileVersion", "2.0.0.0"
            VALUE "InternalName", "MangaFlow-Cpp"
            VALUE "OriginalFilename", "MangaFlow-Cpp.exe"
            VALUE "ProductName", "MangaFlow AI (C++17 Native)"
            VALUE "ProductVersion", "2.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
